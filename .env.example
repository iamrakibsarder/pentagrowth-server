PORT=4000
NODE_ENV=development

# Comma-separated origins that may call admin endpoints from the browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Used by admin dashboard requests. Keep this secret and send it as:
# Authorization: Bearer your-token
ADMIN_API_TOKEN=replace-with-a-long-random-token

PUBLIC_SITE_URL=https://pentagrowth.digital

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BLOG_IMAGE_BUCKET=blog-images
